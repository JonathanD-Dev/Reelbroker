# Copier ce fichier vers .env (à la racine du dépôt) et remplir les valeurs. Ne jamais committer .env.
# Tout est facultatif : sans identifiants AWS, l'application fonctionne en mode hors ligne
# (mêmes calculs, explications rédigées par le code au lieu d'Amazon Bedrock).

# Option 1 : clé d'API Amazon Bedrock (console Bedrock > API keys)
AWS_BEARER_TOKEN_BEDROCK=

# Option 2 : un profil de l'AWS CLI déjà connecté (aws configure sso, aws login...), à la place de la clé
# AWS_PROFILE=

# Région où le modèle est activé
AWS_REGION=us-east-1

# Modèle (facultatif). Par défaut : celui de Strands Agents, global.anthropic.claude-sonnet-4-6
# BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Garde-fou Bedrock Guardrails (facultatif)
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=DRAFT
